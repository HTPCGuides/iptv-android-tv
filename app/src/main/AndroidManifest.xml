<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Android TV: leanback UI, but not *required* so it also installs on phones/tablets
         (handy for testing). No touchscreen requirement — TVs don't have one. -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Android 11+ hides other packages unless asked for: without this the player cannot
         find the Ace Stream app to offer "Open Ace Stream" when its engine has been stopped. -->
    <queries>
        <package android:name="org.acestream.media" />
        <package android:name="org.acestream.node" />
        <package android:name="org.acestream.core" />
    </queries>

    <application
        android:name=".IptvApp"
        android:label="@string/app_name"
        android:banner="@drawable/banner"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.IptvTv"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true">
        <!-- ^ many IPTV streams are plain http:// -->

        <!-- The Cast framework loads this by name at runtime. Without it,
             CastContext.getSharedInstance() throws on first use. -->
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="com.iptvtv.CastOptionsProvider" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:supportsPictureInPicture="true"
            android:screenOrientation="fullUser"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|uiMode|keyboardHidden|navigation">
            <!-- ^ fullUser: follow the device, whichever way it is held, within the user's own
                 auto-rotate setting. A landscape lock came up sideways on an unfolded OnePlus
                 Open whatever the rotation chosen; every screen here is a column that reads
                 fine either way, and the player picks its own orientation (see PlayerScreen).
                 Folding a OnePlus Open changes smallestScreenSize and density as well as
                 screenSize; without those two here the activity was recreated on every
                 fold, and the player with it. Compose re-lays out on its own. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- shows the app on the Android TV / Google TV home screen -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>

            <!-- A playlist handed over by another app: acestream-m3u writes M3U8 files to
                 Downloads and opens them here. A filter naming only MIME types matches
                 content:// and file:// URIs, and a SEND carrying the file in EXTRA_STREAM.
                 singleTask above sends a hand-off to the running app, not a second copy. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/x-mpegurl" />
                <data android:mimeType="audio/mpegurl" />
                <data android:mimeType="application/x-mpegurl" />
                <data android:mimeType="application/vnd.apple.mpegurl" />
            </intent-filter>

            <!-- File managers often label .m3u / .m3u8 with a generic type, so match the name
                 as well. pathPattern cannot backtrack — ".*\\.m3u8" gives up at the first dot
                 in the path — hence the variants for names with more dots in them. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.m3u" />
                <data android:pathPattern=".*\\.m3u8" />
                <data android:pathPattern=".*\\..*\\.m3u" />
                <data android:pathPattern=".*\\..*\\.m3u8" />
                <data android:pathPattern=".*\\..*\\..*\\.m3u" />
                <data android:pathPattern=".*\\..*\\..*\\.m3u8" />
            </intent-filter>
        </activity>
    </application>
</manifest>
